# Copy this file to credentials.auto.tfvars and fill in real values:
#   cp credentials.tfvars.example credentials.auto.tfvars
#
# Terraform automatically loads any *.auto.tfvars file in this directory on every plan/apply
# - no -var-file flag needed. credentials.auto.tfvars is gitignored (see .gitignore) so a
# real key never gets committed; this .example file (with placeholder junk, not a real key)
# is the thing that's actually tracked in git.
#
# Only used when deployment_target = "aws" (variables.tf) - the "local" (minikube) path
# needs none of this and works with zero setup. Cloud-agnostic by design: adding another
# cloud provider later (GCP, Azure, ...) means adding that provider's own credential
# variables here and a new <provider>.tf file (see aws.tf's comments) - nothing about
# namespace.tf/secret.tf/postgres.tf/redis.tf/app.tf/monitoring.tf needs to change, they
# already only know how to talk to "a Kubernetes cluster," not which cloud it's running on.
#
# Get real values from the AWS Console: IAM -> Users -> your user -> Security credentials ->
# Create access key. Use an IAM user with least-privilege permissions for this, not your
# AWS account's root credentials.

aws_access_key_id     = "AKIA_REPLACE_ME"
aws_secret_access_key = "REPLACE_ME"
