# Optional - every variable here already has a working default (see variables.tf), so
# `terraform apply` with zero tfvars files at all deploys locally to minikube. Copy this to
# terraform.tfvars (or just set the ones you actually want to change) only if you want to
# override something. Credentials are handled separately - see credentials.tfvars.example.

# --- Pick your target ---
# deployment_target = "local"   # minikube on this machine (default)
# deployment_target = "aws"     # free-tier EC2 + k3s - also needs credentials.auto.tfvars

# --- Only relevant for deployment_target = "aws" ---
# aws_region        = "us-east-1"
# aws_instance_type = "t3.micro"   # stays within the free tier; anything bigger costs money
# ssh_allowed_cidr  = "0.0.0.0/0"  # narrow to "YOUR_IP/32" if this will stay up a while

# --- Monitoring (Prometheus + Grafana) ---
# enable_monitoring = true   # default; needs ~2GB+ RAM, turn off for a free-tier t3.micro
# enable_monitoring = false

# --- Reproducing this project's earlier host-stress-test scale (12-core/30GB local machine
#     only - do NOT use these against a t3.micro, they will not fit) ---
# app_max_replicas   = 30
# app_cpu_request    = "250m"
# app_memory_request = "300Mi"
# app_cpu_limit      = "800m"
# app_memory_limit   = "512Mi"
